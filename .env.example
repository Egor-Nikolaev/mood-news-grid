# LLM для переписывания тона. НЕ обязателен: без ключа работает rule-based фолбэк.
# Любой OpenAI-совместимый провайдер. По умолчанию — Groq (быстрый, щедрый free-tier).
# Ключ создаётся бесплатно на console.groq.com
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Запасной вариант — OpenRouter (раскомментируй вместо блока выше):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=google/gemma-4-26b-a4b-it:free

# Сколько новостей тянуть за один ingest на источник
INGEST_PER_FEED=16
