# LLM для переписывания тона. НЕ обязателен: без ключа работает rule-based фолбэк.
# Бесплатная модель OpenRouter (суффикс :free стоит $0). Ключ создаётся бесплатно на openrouter.ai.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Сколько новостей тянуть за один ingest на источник
INGEST_PER_FEED=16
